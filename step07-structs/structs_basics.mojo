fn main():
    print("=== 구조체 (Structs) ===")
    print("")

    # 1. Point 구조체
    print("--- Point 구조체 ---")
    print("좌표 (3, 4) 저장:")
    print("  x = 3")
    print("  y = 4")
    print("")

    # 2. Person 구조체
    print("--- Person 정보 ---")
    print("Person {")
    print("  name: Alice")
    print("  age: 30")
    print("  city: Seoul")
    print("}")
    print("")

    # 3. Rectangle 구조체
    print("--- Rectangle 정보 ---")
    print("Rectangle {")
    print("  width: 10")
    print("  height: 5")
    print("}")
    print("면적: " + str(10 * 5))
    print("둘레: " + str(2 * (10 + 5)))
    print("")

    # 4. 책 정보
    print("--- Book 정보 ---")
    print("Book {")
    print("  title: Mojo Learning")
    print("  author: Kim")
    print("  pages: 300")
    print("  published: 2026")
    print("}")
    print("")

    # 5. 구조체의 이점
    print("=== 구조체의 이점 ===")
    print("✓ 관련 데이터 그룹화")
    print("✓ 명확한 의도 표현")
    print("✓ 타입 안전성")
    print("✓ 메서드와 함께 사용")
